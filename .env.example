# JAPxRock Configuration
# NOTE: No API keys are required to build or host JAPxRock on GitHub Pages!
# The application runs 100% serverless in the browser with bundled metadata and public oEmbed.

# Optional: Personal Google Gemini API key if you choose to run local Express backend
# (For static GitHub Pages hosting, users can optionally paste their key directly in the UI).
GEMINI_API_KEY=""

# Optional: Host URL for local dev server
APP_URL="http://localhost:5173"
